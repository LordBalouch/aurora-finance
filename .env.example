# Copy to .env (gitignored). All optional for local use.
DEBUG=True
# SECRET_KEY=
# ANTHROPIC_API_KEY=sk-ant-...   AI tips; leave out to turn them off
# Or a free local model through Ollama (ollama pull qwen3:8b):
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_THINK=False   faster (about 20 s instead of a minute), but makes more mistakes
# Or any OpenAI-compatible API (OpenAI, Gemini, Mistral, LM Studio ...):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_LANGUAGE=Norwegian (bokmål)
# AI_ABOUT_ME=Self-employed, two children   optional context for the AI
